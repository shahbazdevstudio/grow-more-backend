# ---- Grow More backend configuration ----
# Copy to ".env" and fill in. NEVER commit or share ".env".

PORT=5000
NODE_ENV=production

# MongoDB connection string (Atlas or local). Database name is set separately below.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=growmore_v2

# Two long random secrets (32+ chars). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PIN_PEPPER=

# First-run PIN (4 digits). Used only while no owner account exists; remove it after your first login.
INITIAL_PIN=

# Cloudinary - every uploaded image (account logos, product photos) is stored here. Dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=growmore

# Frontend origin(s) allowed to call the API (comma separated, no trailing slash). The production frontend is always allowed.
CLIENT_ORIGIN=https://grow-more-shahbaz.vercel.app

# Cookie settings (production, HTTPS only)
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Set to 1 when behind a reverse proxy / PaaS (Render, Railway, Nginx...) so client IPs are correct
TRUST_PROXY=1

# Used until you pick another in Settings
DEFAULT_TIMEZONE=Asia/Karachi
